# PyInstaller 产物与构建中间物（体积大/可再生，绝不入库）
dist/
build/
*.spec
__pycache__/
*.pyc

# 运行时产物
b2bcollect_data/
*.out
*.log

# 本地密钥与缓存（含 DeepSeek API Key，绝不入库；打包态运行时从本机
# config.json / 环境变量解析，源码仓库里永远不该出现真实密钥）
config.json
deepseek_cache.json

# --acl-doctor 在源码态把报告落在模块目录（打包态落在包外 b2bcollect_state/），
# 它是每次自检都会重写的产物，入库只会让提交面变脏
acl_doctor.txt
